# Copy to backend/.env for local development. In Docker Compose these are supplied via docker/.env.
APP_NAME="Industrial Server Room Monitoring"
ENVIRONMENT=development

# Leave unset to default to backend/data/monitoring.db (see app/core/config.py).
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/monitoring.db

SQL_ECHO=false

# One-time bootstrap password for the seeded "admin" user (database/seed/seed.py).
# Set this before first seeding a production instance; change it on first login regardless.
SEED_ADMIN_PASSWORD=ChangeMe123!

# PLC communication (see ARCHITECTURE.md §3.1, §4.1). Switching protocol is this one value —
# S7PLCClient, ModbusPLCClient, and SimulatedPLCClient all implement the same interface.
# Set PLC_PROTOCOL=simulated to run the whole stack (poller, alarms, dashboard) with no PLC
# hardware/network at all — useful for local dev, demos, and testing alarm scenarios via the
# admin-only /api/v1/system/simulate endpoints. Never use "simulated" in a real deployment.
PLC_PROTOCOL=s7
PLC_ADDRESS=192.168.1.10
PLC_RACK=0
PLC_SLOT=1
PLC_S7_PORT=102
PLC_MODBUS_PORT=502
# Only used when PLC_PROTOCOL=simulated. Fixes the simulated drift so it's reproducible
# run-to-run; leave unset for different random drift each run.
# PLC_SIM_SEED=42
# Leave unset to default to <repo root>/config/plc_tags.yaml.
# TAG_MAP_PATH=/absolute/path/to/plc_tags.yaml

# JWT auth (see ARCHITECTURE.md §3.6, §15). MUST be overridden with a random value for any
# real deployment — the default below is a dev-only placeholder, not a secret.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# How old a sensor's latest reading may be before /live reports it as stale.
LIVE_STALE_THRESHOLD_SECONDS=30

# Origins allowed to call the API (JSON array). The nginx-served frontend build is same-origin
# in production; this only matters for `vite dev` running on a different port during development.
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# Background workers (see ARCHITECTURE.md §9, §12). Times are UTC, "HH:MM".
RAW_RETENTION_DAYS=90
RETENTION_RUN_AT=02:00
BACKUP_RUN_AT=03:00

# Optional MongoDB Atlas historical sync — leave empty to disable entirely (default). Never a
# dependency for core operation: if unset, unreachable, or the internet is down, ingestion/
# alarms/dashboard are completely unaffected.
ATLAS_CONNECTION_STRING=
ATLAS_DATABASE_NAME=server_room_monitor
ATLAS_SYNC_INTERVAL_SECONDS=60

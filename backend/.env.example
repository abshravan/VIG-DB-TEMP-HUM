# Copy to backend/.env for local development. In Docker Compose these are supplied via docker/.env.
APP_NAME="Industrial Server Room Monitoring"
ENVIRONMENT=development

# Leave unset to default to backend/data/monitoring.db (see app/core/config.py).
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/monitoring.db

SQL_ECHO=false

# One-time bootstrap password for the seeded "admin" user (database/seed/seed.py).
# Set this before first seeding a production instance; change it on first login regardless.
SEED_ADMIN_PASSWORD=ChangeMe123!

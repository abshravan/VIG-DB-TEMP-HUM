# Copy to docker/.env before `docker compose up`. Never commit the real .env — it holds
# secrets (JWT_SECRET_KEY, the seed admin password, and the Atlas connection string if used).
#
# DATABASE_URL and TAG_MAP_PATH are NOT set here — docker-compose.yml pins them to the
# container's mounted volume paths (/app/data, /app/config) directly, so they're not
# accidentally overridden by a stale value in this file.

APP_NAME="Industrial Server Room Monitoring"
ENVIRONMENT=production
SQL_ECHO=false

# One-time bootstrap password for the seeded "admin" user — see "First-time setup" in this
# folder's README. Change it via the Settings > Users page immediately after first login.
SEED_ADMIN_PASSWORD=ChangeMe123!

# PLC communication (see ARCHITECTURE.md §3.1) — set these to what the PLC team confirms.
PLC_PROTOCOL=s7
PLC_ADDRESS=192.168.1.10
PLC_RACK=0
PLC_SLOT=1
PLC_S7_PORT=102
PLC_MODBUS_PORT=502

# JWT auth — MUST be a real random secret for any production deployment. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_ME_WITH_A_REAL_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LIVE_STALE_THRESHOLD_SECONDS=30

# The frontend is served same-origin through nginx in production, so this rarely matters —
# it's here for the (uncommon) case of hitting the API directly from a different origin.
CORS_ALLOW_ORIGINS=["http://localhost"]

# Background workers (see ARCHITECTURE.md §9, §12). Times are UTC, "HH:MM".
RAW_RETENTION_DAYS=90
RETENTION_RUN_AT=02:00
BACKUP_RUN_AT=03:00

# Optional MongoDB Atlas historical sync — leave empty to disable entirely (default).
ATLAS_CONNECTION_STRING=
ATLAS_DATABASE_NAME=server_room_monitor
ATLAS_SYNC_INTERVAL_SECONDS=60
